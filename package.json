{
  "name": "fire-n-ice",
  "version": "1.0.0",
  "description": "A remake of a NES game with the same name: Fire 'n Ice",
  "main": "dist/scripts/firenice.min.js",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build && vite build --config vite.lib.config.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "jest",
    "preview": "vite preview",
    "test:site": "node scripts/check-site.cjs",
    "build:lib": "vite build --config vite.lib.config.mjs",
    "preview:http": "http-server dist -a 127.0.0.1 -p 8081 -c-1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eugenioenko/fire-n-ice.git"
  },
  "keywords": [
    "nes",
    "game",
    "fire",
    "ice",
    "javascript"
  ],
  "author": "eugenioenko",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eugenioenko/fire-n-ice/issues"
  },
  "homepage": "https://github.com/eugenioenko/fire-n-ice#readme",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^8.3.4",
    "http-server": "^14.1.1"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
